<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pill_500_kids"
    android:backgroundTint="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_pill_500_kids"
        android:backgroundTint="#CFE8FF" />

    <!-- Header info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_icon_pedestal_soft"
            android:padding="12dp">

            <ImageView
                android:id="@+id/img_modal_servicio_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Icono Servicio"
                android:src="@drawable/ic_flask"
                app:tint="#00A8E8" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_modal_servicio_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:text="Talleres Científicos"
                android:textColor="#0B2C5E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_modal_servicio_modalidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito"
                android:text="Edad: 5 a 13 años • Duración: 1h 30m"
                android:textColor="#00A8E8"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_modal_servicio_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/nunito"
        android:lineSpacingExtra="3dp"
        android:text="Descripción detallada del servicio..."
        android:textColor="#4A6583"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/fredoka"
        android:text="¿Qué incluye este servicio? ✨"
        android:textColor="#0B2C5E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/container_modal_beneficios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_modal_ver_galeria"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/fredoka"
        android:text="🖼️ Ver Fotos de este Servicio en Galería"
        android:textColor="#00A8E8"
        app:cornerRadius="16dp"
        app:strokeColor="#00A8E8"
        app:strokeWidth="1.5dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_modal_cotizar_whatsapp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/fredoka"
        android:text="💬 Solicitar Información por WhatsApp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:backgroundTint="#25D366"
        app:cornerRadius="16dp" />

</LinearLayout>