<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".ui.ShopFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_light"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. BLOQUE HERO CELESTE DE TIENDA 2026 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_shop_hero_sky"
                    android:padding="20dp">

                    <!-- Etiqueta Rectangular Amarilla Superior -->
                    <TextView
                        android:id="@+id/tv_badge_tienda_oficial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="#FDC500"
                        android:fontFamily="@font/fredoka"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="★ TIENDA OFICIAL ★"
                        android:textColor="#0B2C5E"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Píldora Blanca de Colección 2026 -->
                    <TextView
                        android:id="@+id/tv_pill_coleccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="#FFFFFF"
                        android:elevation="2dp"
                        android:fontFamily="@font/fredoka"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✨ COLECCIÓN OFICIAL 2026 · MINICIENTIFICOS"
                        android:textColor="#0B2C5E"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_badge_tienda_oficial" />

                    <!-- Gran Título -->
                    <TextView
                        android:id="@+id/tv_shop_hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/fredoka"
                        android:lineSpacingMultiplier="0.95"
                        android:text="Explora, aprende y\n¡llévalo contigo!"
                        android:textColor="#0B2C5E"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/imgShopHeroPersonajes"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_pill_coleccion" />

                    <!-- Barra Curva Subrayado Celeste brillante -->
                    <View
                        android:id="@+id/v_title_underline"
                        android:layout_width="120dp"
                        android:layout_height="5dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_line_accent_title"
                        android:backgroundTint="#0096FF"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_shop_hero_title" />

                    <!-- Imagen Destacada de Personajes -->
                    <ImageView
                        android:id="@+id/imgShopHeroPersonajes"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Personajes Tienda"
                        android:scaleType="fitCenter"
                        android:src="@drawable/personajes"
                        app:layout_constraintBottom_toBottomOf="@id/v_title_underline"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_shop_hero_title" />

                    <!-- Párrafo Descriptivo -->
                    <TextView
                        android:id="@+id/tv_shop_hero_desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/nunito"
                        android:text="¡La aventura científica para pequeños genios! 17 productos oficiales seguros, divertidos y listos para descubrir el universo. 🚀"
                        android:textColor="#1E3A5F"
                        android:textSize="13.5sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/v_title_underline" />

                    <!-- Fila de 3 Píldoras de Garantía -->
                    <HorizontalScrollView
                        android:id="@+id/hsv_guarantees"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_shop_hero_desc">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Píldora 1 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_guarantee_pill"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="✔ Kits seguros"
                                    android:textColor="#0B2C5E"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Píldora 2 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_guarantee_pill"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="🎨 Diseño infantil"
                                    android:textColor="#0B2C5E"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Píldora 3 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_guarantee_pill"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="🚀 Envíos a todo el país"
                                    android:textColor="#0B2C5E"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. CABECERA DE CATÁLOGOCON MASCOTA DE CARRITO Y BUSCADOR DE BORDE AMARILLO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/fredoka"
                    android:text="Catálogo Científico 🛒"
                    android:textColor="#0B2C5E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Botón Especial de Carrito con Mascota y Contador Rebotante -->
                <FrameLayout
                    android:id="@+id/layoutMascotCartButton"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="Ver Carrito"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mascota_camion" />

                    <!-- Badge Circular Amarillo Rebotante -->
                    <TextView
                        android:id="@+id/tvShopCartBadgeCount"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="#FDC500"
                        android:fontFamily="@font/fredoka"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="#0B2C5E"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <!-- Barra de Búsqueda Oficial con Borde Amarillo -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shop_search_yellow_border"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/iv_search_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_centerVertical="true"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#0096FF" />

                <EditText
                    android:id="@+id/et_search_shop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/btnShopBuscarAccion"
                    android:layout_toEndOf="@id/iv_search_icon"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito"
                    android:hint="Busca por nombre, categoría o descripción..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="10dp"
                    android:textColor="#0B2C5E"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShopBuscarAccion"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="#0B2C5E"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="14dp"
                    android:text="Buscar 🔍"
                    android:textColor="#FDC500"
                    android:textSize="12sp"
                    app:cornerRadius="50dp" />
            </RelativeLayout>

        </LinearLayout>

        <!-- 3. FILTROS DE CATEGORÍA, ORDENAMIENTO Y GRILLA DE PRODUCTOS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_shop_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_todos"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="★ Todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_peluches"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Peluches" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_accesorios"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Accesorios" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_ropa"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Ropa" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_papeleria"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Papelería" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_resultados_count"
                style="@style/TextAppearance.MiniCientificos.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:text="17 productos encontrados"
                android:textColor="#0B2C5E"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ordenar"
                style="@style/TextAppearance.MiniCientificos.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/fredoka"
                android:padding="8dp"
                android:text="Ordenar por: Más relevantes ▾"
                android:textColor="@color/pc_blue"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_stroke" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_productos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <LinearLayout
        android:id="@+id/layout_empty_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <include
            android:id="@+id/layout_empty_state"
            layout="@layout/view_empty_state" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>