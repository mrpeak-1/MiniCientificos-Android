<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollWorkshops"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_workshops_page_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- ========================================================= -->
        <!-- BLOQUE 1 - HERO ILUSTRADO "CONVIÉRTETE EN UN MINICIENTÍFICO" -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_12_talleres_badge"
                android:fontFamily="@font/poppins"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="⚛️ 12 talleres · presenciales y virtuales"
                android:textColor="#0B2C5E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fredoka"
                android:text="Conviértete en un"
                android:textColor="#0B2C5E"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Minicientífico"
                    android:textColor="#FF7A00"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="-4dp"
                    android:background="@drawable/bg_underline_marker_orange" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Descubre el fascinante mundo de la ciencia y la naturaleza. Nuestros talleres están diseñados para despertar la curiosidad de los niños mientras se divierten aprendiendo y cuidando el planeta."
                android:textColor="#546E7A"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHeroVerTalleres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_hero_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="Ver talleres ↓"
                    android:textColor="#0B2C5E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHeroPedirInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_btn_hero_outline_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="Pedir información"
                    android:textColor="#0B2C5E"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="32dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Marco de la foto -->
                <ImageView
                    android:id="@+id/cardHeroWorkshopImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_hero_photo_frame"
                    android:clipToOutline="true"
                    android:contentDescription="Niños en taller científico"
                    android:scaleType="centerCrop"
                    android:src="@drawable/microbiologia" />

                <!-- Burbujas flotantes animadas -->
                <TextView
                    android:id="@+id/orbTelescopio"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_floating_orb_white"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🔭"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/orbMatraz"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/bg_floating_orb_white"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🧪"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/orbPlanta"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="40dp"
                    android:background="@drawable/bg_floating_orb_white"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🌱"
                    android:textSize="22sp" />
            </FrameLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 2 - BUSCADOR CIENTÍFICO Y SISTEMA DE DOBLE FILTRO CROSS -->
        <!-- ========================================================= -->
        <LinearLayout
            android:id="@+id/layoutFiltrosTalleres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Buscador -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#FFFFFF"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxStrokeColor="#64B5F6"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="#64B5F6">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscarTaller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:hint="Busca un taller (Ej: Bobina Tesla, Huerto...)"
                    android:inputType="text"
                    android:paddingVertical="14dp"
                    android:textColor="#0B2C5E"
                    android:textColorHint="#90A4AE"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Categorías -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCatTodo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_pill_green_active"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="TODO"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCatCiencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_white_inactive"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="CIENCIA"
                    android:textColor="#78909C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCatNaturaleza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_white_inactive"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="NATURALEZA"
                    android:textColor="#78909C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Modalidades -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModPresencial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_pill_white_inactive"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="PRESENCIAL"
                    android:textColor="#78909C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnModVirtual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_white_inactive"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="VIRTUAL"
                    android:textColor="#78909C"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnModHibrido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_pill_white_inactive"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="HÍBRIDO"
                    android:textColor="#78909C"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Elige tu próxima aventura:"
                    android:textColor="#0B2C5E"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="todos nuestros TALLERES"
                        android:textColor="#FF7A00"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="-2dp"
                        android:background="@drawable/bg_underline_marker_orange" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSubtituloFiltroDinamico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/nunito"
                    android:text="Mostrando 12 talleres disponibles"
                    android:textColor="#546E7A"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 3 - CATÁLOGO DE LAS 12 TARJETAS ESTILO PÓSTER -->
        <!-- ========================================================= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTalleres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="16dp"
            tools:listitem="@layout/item_taller" />

        <LinearLayout
            android:id="@+id/layoutEmptyTalleres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_floating_orb_white"
                android:gravity="center"
                android:text="🔍"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fredoka"
                android:text="¡Uy! No encontramos talleres"
                android:textColor="#0B2C5E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/nunito"
                android:text="Intenta con otros filtros o términos de búsqueda."
                android:textColor="#546E7A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 4 - PIE DE PÁGINA CORPORATIVO -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="#0B2C5E"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_flask"
                app:tint="#FDC500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/fredoka"
                android:text="MINICIENTÍFICOS"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:text="Despertando la curiosidad y la pasión por la ciencia y la naturaleza en niños."
                android:textColor="#90CAF9"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#1E4785" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="WhatsApp: +51 916 313 634"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>