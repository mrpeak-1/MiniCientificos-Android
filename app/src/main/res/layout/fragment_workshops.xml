<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollWorkshops"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_workshops_page_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- ========================================================= -->
        <!-- BLOQUE 1 - HERO ILUSTRADO "CONVIÉRTETE EN UN MINICIENTÍFICO" -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_12_talleres_badge"
                android:fontFamily="@font/nunito"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="⚛️ 12 talleres · presenciales y virtuales"
                android:textColor="#0B2C5E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fredoka"
                android:text="Conviértete en un"
                android:textColor="#0B2C5E"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Minicientífico"
                    android:textColor="#FF7A00"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="-4dp"
                    android:background="@drawable/bg_underline_marker_orange" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Descubre el fascinante mundo de la ciencia y la naturaleza. Nuestros talleres están diseñados para despertar la curiosidad de los niños mientras se divierten aprendiendo y cuidando el planeta."
                android:textColor="#546E7A"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHeroVerTalleres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_hero_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="Ver talleres ↓"
                    android:textColor="#0B2C5E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHeroPedirInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_btn_hero_outline_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="Pedir información"
                    android:textColor="#0B2C5E"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="32dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Marco de la foto -->
                <ImageView
                    android:id="@+id/cardHeroWorkshopImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_hero_photo_frame"
                    android:clipToOutline="true"
                    android:contentDescription="Niños en taller científico"
                    android:scaleType="centerCrop"
                    android:src="@drawable/microbiologia" />

                <!-- Burbujas flotantes animadas -->
                <TextView
                    android:id="@+id/orbTelescopio"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_floating_orb_white"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🔭"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/orbMatraz"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/bg_floating_orb_white"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🧪"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/orbPlanta"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="40dp"
                    android:background="@drawable/bg_floating_orb_white"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🌱"
                    android:textSize="22sp" />
            </FrameLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 2 - BUSCADOR CIENTÍFICO Y PANEL DE FILTROS COLORIDOS -->
        <!-- ========================================================= -->
        <LinearLayout
            android:id="@+id/layoutFiltrosTalleres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- 1. BARRA DE BÚSQUEDA RENOVADA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_workshop_search_pill"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#0066CC" />

                <EditText
                    android:id="@+id/etBuscarTaller"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/nunito"
                    android:hint="¿Qué taller estás buscando?"
                    android:inputType="text"
                    android:textColor="#0B2C5E"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnAccionBuscarTaller"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_search_blue_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="Buscar"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. GRAN BOTÓN VERDE "VER TODOS LOS TALLERES ✓" -->
            <LinearLayout
                android:id="@+id/btnFiltroVerTodos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_ver_todos_green"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_white_icon">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="⊞"
                        android:textColor="#16A34A"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTextoVerTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/fredoka"
                    android:text="VER TODOS LOS TALLERES ✓"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. SECCIÓN "✨ Elige el tipo de curso: ✨" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/fredoka"
                android:text="✨ Elige el tipo de curso: ✨"
                android:textColor="#0B2C5E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 3 Botones Píldora de Categoría -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Categoría: CIENCIA -->
                <LinearLayout
                    android:id="@+id/btnCatCiencia"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_cat_ciencia"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_circle_white_icon">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🧪"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelCatCiencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/fredoka"
                        android:text="CIENCIA →"
                        android:textColor="#0B2C5E"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Categoría: NATURALEZA -->
                <LinearLayout
                    android:id="@+id/btnCatNaturaleza"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_cat_naturaleza"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_circle_white_icon">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🍃"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelCatNaturaleza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/fredoka"
                        android:text="NATURALEZA →"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Categoría: TECNOLOGÍA -->
                <LinearLayout
                    android:id="@+id/btnCatTecnologia"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_cat_tecnologia"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_circle_white_icon">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🟣"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelCatTecnologia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/fredoka"
                        android:text="TECNOLOGÍA →"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. SECCIÓN "Elige la modalidad:" CON FRANJA RESALTADORA AMARILLA -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_marker_yellow_highlighter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:paddingHorizontal="8dp"
                    android:text="Elige la modalidad:"
                    android:textColor="#0B2C5E"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 2 Botones Píldora de Modalidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Modalidad: PRESENCIAL -->
                <LinearLayout
                    android:id="@+id/btnModPresencial"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_mod_presencial"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_white_icon">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="👥"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelModPresencial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/fredoka"
                        android:text="PRESENCIAL →"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Modalidad: VIRTUAL -->
                <LinearLayout
                    android:id="@+id/btnModVirtual"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_mod_virtual"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_white_icon">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="💻"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLabelModVirtual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/fredoka"
                        android:text="VIRTUAL →"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Subtítulo dinámico -->
            <TextView
                android:id="@+id/tvSubtituloFiltroDinamico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/nunito"
                android:text="Mostrando 12 talleres disponibles"
                android:textColor="#546E7A"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 3 - CATÁLOGO DE LAS 12 TARJETAS ESTILO PÓSTER       -->
        <!-- ========================================================= -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTalleres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="16dp"
            tools:listitem="@layout/item_taller" />

        <LinearLayout
            android:id="@+id/layoutEmptyTalleres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_floating_orb_white"
                android:gravity="center"
                android:text="🔍"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fredoka"
                android:text="¡Uy! No encontramos talleres"
                android:textColor="#0B2C5E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/nunito"
                android:text="Intenta con otros filtros o términos de búsqueda."
                android:textColor="#546E7A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 4 - PIE DE PÁGINA CORPORATIVO                       -->
        <!-- ========================================================= -->
        <include
            android:id="@+id/layout_corporate_footer"
            layout="@layout/layout_corporate_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>