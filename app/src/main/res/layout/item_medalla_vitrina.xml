<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMedallaItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#CBD5E1"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Medallón Emoji -->
        <TextView
            android:id="@+id/tvMedallaEmoji"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_white_icon"
            android:elevation="2dp"
            android:gravity="center"
            android:textSize="26sp"
            tools:text="🌱" />

        <TextView
            android:id="@+id/tvMedallaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/fredoka"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#0B2C5E"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Guardián del Biohuerto" />

        <TextView
            android:id="@+id/tvMedallaDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#475569"
            android:textSize="11sp"
            tools:text="Completa tus primeras lecciones de botánica e hidroponía." />

        <!-- Estado: DESBLOQUEADA o BLOQUEADA -->
        <TextView
            android:id="@+id/tvMedallaEstadoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="#DCFCE7"
            android:fontFamily="@font/fredoka"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#15803D"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="✓ DESBLOQUEADA" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
