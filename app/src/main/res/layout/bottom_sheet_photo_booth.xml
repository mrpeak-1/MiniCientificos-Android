<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cart_header_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Barra de arrastre modal -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_washi_tape" />

        <!-- Cabecera Photo Booth -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_yellow_icon"
                android:gravity="center"
                android:text="📸"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Photo Booth Científico"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito"
                    android:text="Estampa tu foto con marcos oficiales de Titan y Tesla"
                    android:textColor="#BAE6FD"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnClosePhotoBooth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Cerrar"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Vista Previa Canvas HD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#071E3D"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:strokeColor="#FDC500"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/ivPhotoBoothPreview"
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:adjustViewBounds="true"
                android:contentDescription="Vista previa del marco científico"
                android:scaleType="fitCenter"
                tools:src="@drawable/tratamiento_agua_1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Paso 1: Elegir Origen de Fotografía -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/fredoka"
            android:text="1. Elige tu fotografía:"
            android:textColor="#FDC500"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnElegirFotoCelular"
                style="@style/Widget.MiniCientificos.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="📁 Mi Galería"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:cornerRadius="23dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCambiarFotoApp"
                style="@style/Widget.MiniCientificos.Button.Eco"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="🔬 Otra Foto App"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:cornerRadius="23dp" />
        </LinearLayout>

        <!-- Paso 2: Elegir uno de los 3 Marcos Oficiales Kawaii -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/fredoka"
            android:text="2. Elige un Marco Oficial de Laboratorio:"
            android:textColor="#FDC500"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMarcosBooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMarcoTitan"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/fredoka"
                android:text="🚀 Laboratorio Espacial de Titan"
                android:textColor="@color/chip_credencial_text"
                app:chipBackgroundColor="@color/chip_credencial_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMarcoTesla"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:text="🌱 Guardián Ecológico de Tesla"
                android:textColor="@color/chip_credencial_text"
                app:chipBackgroundColor="@color/chip_credencial_bg" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMarcoFeria"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:text="🏆 Feria de Ciencias ICSM"
                android:textColor="@color/chip_credencial_text"
                app:chipBackgroundColor="@color/chip_credencial_bg" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Paso 3: Frase Personalizada -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/fredoka"
            android:text="3. Frase científica personalizada:"
            android:textColor="#FDC500"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#00A8E8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFrasePhotoBooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito"
                android:hint="Escribe tu frase científica..."
                android:maxLength="48"
                android:singleLine="true"
                android:text="¡Hoy descubrí la magia de la ciencia!"
                android:textColor="#0B2C5E"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Acciones Finales: Guardar + Compartir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarPhotoBooth"
                style="@style/Widget.MiniCientificos.Button.Accent"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="💾 Guardar PNG"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="25dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompartirPhotoBooth"
                style="@style/Widget.MiniCientificos.Button.WhatsApp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="📤 Compartir"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="25dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
