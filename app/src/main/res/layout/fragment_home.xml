<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Sección 1: Cuadro Azul de Inicio (Welcome Carousel) -->
        <include
            android:id="@+id/welcomeSection"
            layout="@layout/layout_home_welcome" />

        <!-- Sección 2: Servicios y Píldoras -->
        <include
            android:id="@+id/servicesPillsSection"
            layout="@layout/layout_home_services_and_pills" />

        <!-- Sección 3: Integrante 2 (Mini Planeta 3D) Placeholder -->
        <FrameLayout
            android:id="@+id/containerMiniPlaneta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp" />

        <!-- Sección 4: Personajes (Video Parallax Scroll) - VA AL FINAL -->
        <include
            android:id="@+id/videoSection"
            layout="@layout/layout_home_video_scroll_section" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>