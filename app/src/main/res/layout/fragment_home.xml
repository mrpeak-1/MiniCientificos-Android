<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollViewHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="0dp">

        <!-- =================================================================== -->
        <!-- BLOQUE 1 - EXISTENTE (MANTENER INTACTO): HERO SLIDER SUPERIOR       -->
        <!-- =================================================================== -->
        <View
            android:id="@+id/hero_background"
            android:layout_width="0dp"
            android:layout_height="320dp"
            android:background="@drawable/bg_hero_sky_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_m"
            android:fontFamily="@font/fredoka"
            android:text="@string/app_name"
            android:textColor="@color/pc_navy"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_app_tagline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_marginEnd="@dimen/spacing_m"
            android:fontFamily="@font/nunito"
            android:text="¡Aprende, experimenta y diviértete!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_app_title" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_hero"
            android:layout_width="0dp"
            android:layout_height="@dimen/hero_slider_height"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_app_tagline" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_pager_hero"
            app:tabBackground="@drawable/bg_indicator_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="16dp" />

        <ImageView
            android:id="@+id/iv_wave_divider"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitXY"
            android:src="@drawable/wave_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hero_background" />

        <!-- =================================================================== -->
        <!-- BLOQUES 2 Y 3 - NUEVO (INTEGRANTE 1): SERVICIOS Y 12 PÍLDORAS      -->
        <!-- =================================================================== -->
        <include
            android:id="@+id/section_servicios_pildoras"
            layout="@layout/layout_home_bloque_servicios_pildoras"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_wave_divider" />

        <!-- =================================================================== -->
        <!-- BLOQUE 4 - EXISTENTE (MANTENER INTACTO): EXPLORA EL MINI PLANETA    -->
        <!-- =================================================================== -->
        <include
            android:id="@+id/section_mini_planeta"
            layout="@layout/layout_home_mini_planeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/section_servicios_pildoras" />

        <!-- =================================================================== -->
        <!-- BLOQUE 5 - NUEVO (INTEGRANTE 1): VIDEO SCROLL Y TARJETAS CÓSMICAS  -->
        <!-- =================================================================== -->
        <include
            android:id="@+id/section_video_scroll"
            layout="@layout/layout_home_bloque_video_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/section_mini_planeta" />

        <!-- =================================================================== -->
        <!-- BLOQUE 6 - EXISTENTE (MANTENER INTACTO): FOOTER CORPORATIVO         -->
        <!-- =================================================================== -->
        <include
            android:id="@+id/section_corporate_footer"
            layout="@layout/layout_corporate_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/section_video_scroll" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>