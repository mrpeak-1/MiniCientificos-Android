<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="820dp"
    android:background="#FFFFFF">

    <!-- CAPA 1: PlayerView de ExoPlayer + Fallback -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerViewHomeVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fill"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <ImageView
            android:id="@+id/imgVideoFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Video Background"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_hero_sky_gradient"
            android:visibility="gone" />
    </FrameLayout>

    <!-- CAPA 2: Fade Superior e Inferior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_video_fade_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_video_fade_bottom" />

    <!-- CAPA 3: Botón Mute / Unmute Floating -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleVideoAudio"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp"
        android:fontFamily="@font/fredoka"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="🔇 Activar sonido"
        android:textColor="#0B2C5E"
        android:textSize="12sp"
        app:backgroundTint="#EBFFFFFF"
        app:cornerRadius="20dp" />

    <!-- CAPA 4: Contenido Frontal con Scroll y Tarjetas Cósmicas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">

        <!-- TARJETA 1: Titan y Tesla -->
        <LinearLayout
            android:id="@+id/cardScrollTitanTesla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="110dp"
            android:layout_marginBottom="70dp"
            android:background="@drawable/bg_card_titan_tesla_gold"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:text="Conoce a Titan y Tesla"
                android:textColor="#0047B8"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="¡Aquí te presento a Titan y Tesla, nuestros guías científicos oficiales! Ellos acompañarán a los chicos en cada aventura, haciendo que la ciencia, la ecología y la tecnología cobren vida de la manera más divertida."
                android:textColor="#1E293B"
                android:textSize="14.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollConocerPersonajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fredoka"
                android:text="⚡ Ver fichas de Titan y Tesla"
                android:textColor="#0B2C5E"
                android:textSize="13.5sp"
                app:backgroundTint="#FFD700"
                app:cornerRadius="20dp" />
        </LinearLayout>

        <!-- TARJETA 2: El Futuro en sus Manos -->
        <LinearLayout
            android:id="@+id/cardScrollFuturoManos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_titan_tesla_gold"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:text="El Futuro en sus Manos"
                android:textColor="#0047B8"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Juntos aprenderán a experimentar, reciclar y programar mientras descubren que el conocimiento no tiene límites y que el futuro está en sus manos. ¡Prepárate para explorar con ellos!"
                android:textColor="#1E293B"
                android:textSize="14.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollExplorarTalleres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/fredoka"
                android:text="🔬 Explorar nuestros talleres"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                app:backgroundTint="#00A8E8"
                app:cornerRadius="20dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>