<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_blue"
    android:fillViewport="true"
    tools:context=".ui.ContactoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m">

        <!-- DECORACIÓN ESTRELLAS ESPACIALES -->
        <ImageView
            android:id="@+id/iv_star_1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Estrella"
            android:src="@drawable/ic_star_decoration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_star_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Estrella"
            android:src="@drawable/ic_star_decoration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_star_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Estrella"
            android:src="@drawable/ic_star_decoration"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- HEADER Y TÍTULO ASTRONÓMICO -->
        <TextView
            android:id="@+id/tv_contacto_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:fontFamily="@font/fredoka"
            android:gravity="center"
            android:text="Contacto Espacial 🌌"
            android:textColor="@color/gold_yellow"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_contacto_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="Envíanos una transmisión desde cualquier rincón del planeta o la galaxia"
            android:textColor="#E0F7FE"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_contacto_titulo" />

        <!-- TARJETA CONTENEDORA DEL FORMULARIO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_form_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            app:cardBackgroundColor="#16324F"
            app:cardCornerRadius="@dimen/corner_radius_l"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_contacto_sub"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <!-- CAMPO 1: NOMBRE COMPLETO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_nombre"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre Completo *"
                    android:textColorHint="#8D99AE"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/primary_blue"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_nombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="textPersonName"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO 2: CORREO ELECTRÓNICO -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="Correo Electrónico *"
                    android:textColorHint="#8D99AE"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/primary_blue"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO 3: TELÉFONO / WHATSAPP -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_telefono"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="Teléfono / WhatsApp *"
                    android:textColorHint="#8D99AE"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/primary_blue"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_telefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="phone"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO 4: ASUNTO DE LA TRANSMISIÓN -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_asunto"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="Asunto *"
                    android:textColorHint="#8D99AE"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/primary_blue"
                    app:startIconDrawable="@drawable/ic_subject"
                    app:startIconTint="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_asunto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CAMPO 5: MENSAJE ESPACIAL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_mensaje"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:hint="Mensaje Espacial *"
                    android:textColorHint="#8D99AE"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/primary_blue"
                    app:startIconDrawable="@drawable/ic_message"
                    app:startIconTint="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_mensaje"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:lines="4"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- BOTÓN LLAMATIVO DE ENVÍO REDONDEADO -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enviar_contacto"
                    style="@style/Widget.MiniCientificos.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:backgroundTint="#00A8E8"
                    android:fontFamily="@font/fredoka"
                    android:text="🚀 ENVIAR MENSAJE ESPACIAL"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_rocket"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>