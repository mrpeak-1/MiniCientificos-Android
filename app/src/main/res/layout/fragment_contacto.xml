<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollContacto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_contact_page_gradient"
    android:fillViewport="true"
    tools:context=".ui.ContactoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- ========================================================= -->
        <!-- BLOQUE 1 - HERO "¡HABLEMOS DE CIENCIA!" CON TITAN Y TESLA  -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Píldora blanca superior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_workshop_search_pill"
                android:elevation="2dp"
                android:fontFamily="@font/fredoka"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="📬 Contáctanos"
                android:textColor="#EA580C"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Gran Título: "¡Hablemos de ciencia!" -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="¡Hablemos de "
                    android:textColor="#0B2C5E"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="ciencia"
                        android:textColor="#FF7A00"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="-2dp"
                        android:background="#FDC500" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="!"
                    android:textColor="#0B2C5E"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtítulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:text="Cuéntanos tu duda, la de tus papás, o cuál taller te llama más la atención. ¡Te respondemos volando! 🚀"
                android:textColor="#334155"
                android:textSize="14.5sp" />

            <!-- Fila de 2 Botones 3D -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnHeroContactoEscribir"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_btn_green_3d"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="💬 Escríbenos ya"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnHeroContactoVerTalleres"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_yellow_3d"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="🧪 Ver talleres"
                    android:textColor="#0B2C5E"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Ilustración Circular de Titan y Tesla con Globo de Diálogo -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Círculo crema con borde punteado celeste -->
                <FrameLayout
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_contact_titan_tesla_circle">

                    <ImageView
                        android:layout_width="135dp"
                        android:layout_height="135dp"
                        android:layout_gravity="center"
                        android:contentDescription="Titan y Tesla"
                        android:scaleType="fitCenter"
                        android:src="@drawable/personajes" />
                </FrameLayout>

                <!-- Globo de Diálogo en la esquina superior derecha -->
                <LinearLayout
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="-8dp"
                    android:background="@drawable/bg_contact_speech_bubble"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="¡Titan y Tesla están listos para leer tu mensaje!"
                        android:textColor="#0B2C5E"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 2 - LAS 3 TARJETAS DE ACCESO RÁPIDO (PASTELEADO)    -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Tarjeta 1: WhatsApp -->
            <LinearLayout
                android:id="@+id/cardQuickWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_contact_card_quick_wa"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_box_wa">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_whatsapp"
                        app:tint="#16A34A" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="WhatsApp"
                        android:textColor="#0B2C5E"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:text="916 313 634"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Chat →"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tarjeta 2: Síguenos (Redes Sociales) -->
            <LinearLayout
                android:id="@+id/cardQuickSiguenos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_contact_card_quick_social"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_box_social">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="💬"
                        android:textSize="22sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="Síguenos"
                        android:textColor="#0B2C5E"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <!-- 3 Botones Circulares Interactivos -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSocialFacebook"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_circle_social_fb"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="f"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSocialInstagram"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_circle_social_ig"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="📷"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnSocialTiktok"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_circle_social_tt"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="🎵"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta 3: Talleres -->
            <LinearLayout
                android:id="@+id/cardQuickTalleres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_contact_card_quick_workshops"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_box_workshops">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🚀"
                        android:textSize="22sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="Talleres"
                        android:textColor="#0B2C5E"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito"
                        android:text="Mira los próximos talleres"
                        android:textColor="#475569"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Ver →"
                    android:textColor="#EAB308"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 3 - FORMULARIO CON TOLDO NARANJA ONDULADO           -->
        <!-- ========================================================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFormularioContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="5dp"
            app:strokeColor="#BFDBFE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Cabecera Naranja-Amarilla con Toldo Ondulado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_contact_awning_header"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka"
                            android:text="Envíanos un mensaje"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/nunito"
                            android:text="Completa tus datos y te escribimos por WhatsApp"
                            android:textColor="#FFFBEB"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:text="✉️"
                        android:textSize="32sp" />
                </LinearLayout>

                <!-- Cuerpo del Formulario -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Campo 1: Nombre completo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_contact_input_sky_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_yellow_icon"
                            android:gravity="center"
                            android:text="👤"
                            android:textSize="18sp" />

                        <EditText
                            android:id="@+id/etContactoNombre"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:fontFamily="@font/nunito"
                            android:hint="Nombre completo *"
                            android:inputType="textPersonName"
                            android:textColor="#0B2C5E"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Campo 2: Celular -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_contact_input_sky_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_yellow_icon"
                            android:gravity="center"
                            android:text="📞"
                            android:textSize="18sp" />

                        <EditText
                            android:id="@+id/etContactoCelular"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:fontFamily="@font/nunito"
                            android:hint="Número de celular *"
                            android:inputType="phone"
                            android:maxLength="9"
                            android:textColor="#0B2C5E"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Campo 3: Correo electrónico -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_contact_input_sky_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_yellow_icon"
                            android:gravity="center"
                            android:text="✉️"
                            android:textSize="18sp" />

                        <EditText
                            android:id="@+id/etContactoCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:fontFamily="@font/nunito"
                            android:hint="Correo electrónico *"
                            android:inputType="textEmailAddress"
                            android:textColor="#0B2C5E"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Campo 4: Motivo desplegable -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_contact_input_sky_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_yellow_icon"
                            android:gravity="center"
                            android:text="🏷️"
                            android:textSize="18sp" />

                        <AutoCompleteTextView
                            android:id="@+id/actvContactoMotivo"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:completionThreshold="0"
                            android:dropDownHeight="200dp"
                            android:fontFamily="@font/nunito"
                            android:hint="Motivo del mensaje *"
                            android:inputType="none"
                            android:textColor="#0B2C5E"
                            android:textColorHint="#94A3B8"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/btnFlechaMotivo"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_circle_yellow_icon"
                            android:gravity="center"
                            android:text="▾"
                            android:textColor="#0B2C5E"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Campo 5: Mensaje multilínea -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="110dp"
                        android:background="@drawable/bg_contact_input_sky_box"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_yellow_icon"
                            android:gravity="center"
                            android:text="💬"
                            android:textSize="18sp" />

                        <EditText
                            android:id="@+id/etContactoMensaje"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:fontFamily="@font/nunito"
                            android:gravity="top"
                            android:hint="Escribe tu consulta aquí... *"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="#0B2C5E"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Botón Principal Verde 3D -->
                    <TextView
                        android:id="@+id/btnEnviarContactoWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_btn_whatsapp_green_3d"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/fredoka"
                        android:gravity="center"
                        android:text="💬 Enviar por WhatsApp"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Nota inferior -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/nunito"
                        android:gravity="center"
                        android:text="Un adulto responsable puede completar este formulario."
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================================= -->
        <!-- BLOQUE 4 - TARJETA "¿CÓMO FUNCIONA? 🧐"                    -->
        <!-- ========================================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_contact_card_howitworks"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:text="¿Cómo funciona? 🧐"
                android:textColor="#0B2C5E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Línea de Tiempo Vertical de 3 Pasos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Paso 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_yellow_icon"
                        android:backgroundTint="#F97316"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka"
                            android:text="Completa el formulario"
                            android:textColor="#0B2C5E"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Tu nombre, celular y lo que nos quieres contar."
                            android:textColor="#475569"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Conector -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="15dp"
                    android:background="#CBD5E1" />

                <!-- Paso 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_yellow_icon"
                        android:backgroundTint="#16A34A"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka"
                            android:text="Se abre WhatsApp"
                            android:textColor="#0B2C5E"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Tu mensaje aparece listo, solo toca enviar."
                            android:textColor="#475569"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Conector -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="15dp"
                    android:background="#CBD5E1" />

                <!-- Paso 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_yellow_icon"
                        android:backgroundTint="#0284C7"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka"
                            android:text="Te respondemos"
                            android:textColor="#0B2C5E"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="Nuestro equipo te escribe con toda la info."
                            android:textColor="#475569"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Caja de Cita de Titán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_titan_quote_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐱"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito"
                    android:text="¡Titán dice que ninguna pregunta es demasiado pequeña!"
                    android:textColor="#0B2C5E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- ========================================================= -->
        <!-- BLOQUE 5 - FOOTER CORPORATIVO                              -->
        <!-- ========================================================= -->
        <include
            android:id="@+id/layout_corporate_footer"
            layout="@layout/layout_corporate_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>