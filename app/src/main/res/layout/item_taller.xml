<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_taller_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Banner temático superior -->
        <FrameLayout
            android:id="@+id/fl_taller_banner"
            android:layout_width="0dp"
            android:layout_height="190dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_taller_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Imagen del taller"
                android:scaleType="centerCrop"
                tools:src="@drawable/astronomia" />

            <!-- Scrim oscuro para contraste de texto -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_taller_poster_scrim" />

            <!-- Títulos tipo póster sobre el banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_poster_linea1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="ASTRONOMÍA" />

                <TextView
                    android:id="@+id/tv_poster_linea2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:shadowColor="#FF000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="SOSTENIBLE PARA NIÑOS" />
            </LinearLayout>

            <!-- Píldora de modalidad -->
            <TextView
                android:id="@+id/tv_badge_modalidad_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_badge_rounded"
                android:fontFamily="@font/poppins"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:backgroundTint="#FF9800"
                tools:text="Presencial / Virtual" />
        </FrameLayout>

        <!-- Contenedor Inferior Blanco -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fl_taller_banner">

            <TextView
                android:id="@+id/tv_titulo_corto_taller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka"
                android:gravity="center"
                android:textColor="#0B2C5E"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="ASTRONOMÍA" />

            <TextView
                android:id="@+id/tv_descripcion_corta_taller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nunito"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="#546E7A"
                android:textSize="13.5sp"
                tools:text="¡Viaja al espacio sin salir de casa! Conviértete en un astronauta, descubre planetas lejanos y mira las estrellas." />

            <TextView
                android:id="@+id/tv_info_row_taller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="📅 Sábados 4:00 PM · 👥 10 cupos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_detalle_taller"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_ver_detalle_eco"
                android:fontFamily="@font/fredoka"
                android:paddingHorizontal="28dp"
                android:text="Ver detalle"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>