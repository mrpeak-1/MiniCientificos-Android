<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_rounded">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <!-- ============================================== -->
            <!-- CABECERA MULTIMEDIA (ExoPlayer Híbrido)      -->
            <!-- ============================================== -->
            <FrameLayout
                android:id="@+id/fl_media_container"
                android:layout_width="0dp"
                android:layout_height="230dp"
                android:background="#000000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Imagen Poster Fallback -->
                <ImageView
                    android:id="@+id/imgPosterDetalleFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Banner del Taller"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/astronomia" />

                <!-- ExoPlayer View Nativo (Media3) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerViewDetalleTaller"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="false"
                    app:resize_mode="zoom" />

                <!-- Controles Custom Superpuestos -->
                <RelativeLayout
                    android:id="@+id/layoutCustomVideoControls"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <!-- Botón Central Play/Pause -->
                    <ImageView
                        android:id="@+id/btnPlayPauseVideo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/bg_floating_orb_white"
                        android:contentDescription="Play/Pause"
                        android:padding="16dp"
                        android:src="@drawable/ic_search"
                        app:tint="#0B2C5E" />

                    <!-- Barra Inferior de Controles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_alignParentBottom="true"
                        android:background="#66000000"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvTiempoVideo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="0:00 / 0:00"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekBarVideoTaller"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:progressTint="#85B84F"
                            android:thumbTint="#85B84F" />

                        <TextView
                            android:id="@+id/btnMuteUnmuteTaller"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/poppins"
                            android:text="🔇 Sonido"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Animación de Carga Central -->
                <ProgressBar
                    android:id="@+id/pbVideoLoading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#85B84F"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Degradado semitransparente sobre el video para botones -->
            <View
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_taller_poster_scrim"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botón Cerrar Flotante "✕" -->
            <TextView
                android:id="@+id/btnCerrarDetalleTaller"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_floating_orb_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#0B2C5E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- ============================================== -->
            <!-- CUERPO COMPLETO DEL MODAL                    -->
            <!-- ============================================== -->

            <!-- Chips Informativos: Categoría, Edad, Duración -->
            <LinearLayout
                android:id="@+id/llChipsInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_media_container">

                <TextView
                    android:id="@+id/tvModalCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_12_talleres_badge"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="#0B2C5E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Ciencia" />

                <TextView
                    android:id="@+id/tvModalEdad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_12_talleres_badge"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="#0B2C5E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="6 a 12 años" />

                <TextView
                    android:id="@+id/tvModalDuracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_12_talleres_badge"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="#0B2C5E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="2 horas" />
            </LinearLayout>

            <!-- Título Principal -->
            <TextView
                android:id="@+id/tv_modal_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="@font/fredoka"
                android:textColor="#0B2C5E"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llChipsInfo"
                tools:text="ASTRONOMÍA" />

            <!-- Precio en Soles Destacado -->
            <TextView
                android:id="@+id/tv_modal_precio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:textColor="#00A8E8"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_modal_titulo"
                tools:text="Inversión: S/ 45.00" />

            <!-- Selector Interactivo de Modalidad -->
            <LinearLayout
                android:id="@+id/llSelectorModalidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_modal_precio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="Selecciona tu modalidad preferida:"
                    android:textColor="#0B2C5E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipModalidadPresencial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_pill_green_active"
                        android:fontFamily="@font/fredoka"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="📍 Presencial"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipModalidadVirtual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_filter_pill_white_inactive"
                        android:fontFamily="@font/fredoka"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="💻 Virtual"
                        android:textColor="#78909C"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta Objetivo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardObjetivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#EAF6FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llSelectorModalidad"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="🎯 Objetivo del Taller"
                        android:textColor="#0B2C5E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_modal_objetivo_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/nunito"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#37474F"
                        android:textSize="14sp"
                        tools:text="Comprender la estructura del sistema solar..." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Temario y Materiales en Layout Vertical Completo -->
            <LinearLayout
                android:id="@+id/llContenidoDetallado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardObjetivo">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="🧪 Temario (¿Qué aprenderemos?)"
                    android:textColor="#0B2C5E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_temario_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fredoka"
                    android:text="🧰 Materiales Incluidos"
                    android:textColor="#0B2C5E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_materiales_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- Horario y Vacantes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHorarioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llContenidoDetallado"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="📅 Horario y Vacantes"
                        android:textColor="#0B2C5E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_modal_horario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/nunito"
                        android:textColor="#546E7A"
                        android:textSize="15sp"
                        tools:text="Sábados 4:00 PM - 6:00 PM" />

                    <TextView
                        android:id="@+id/tv_modal_cupos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#FF7A00"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="10 vacantes disponibles" />

                    <ProgressBar
                        android:id="@+id/pbVacantes"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="4dp"
                        android:progress="60"
                        android:progressDrawable="@drawable/bg_underline_marker_orange" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón CTA WhatsApp Fijo Inferior -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_whatsapp_inscribirse"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#25D366"
                android:fontFamily="@font/fredoka"
                android:text="💬 Inscribirme o Consultar por WhatsApp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="50dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardHorarioInfo" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>