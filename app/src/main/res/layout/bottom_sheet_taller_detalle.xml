<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_rounded">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Banner / Video Híbrido ExoPlayer -->
            <FrameLayout
                android:id="@+id/fl_media_container"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:background="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_modal_taller_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Banner del Taller"
                    android:scaleType="centerCrop"
                    android:visibility="visible"
                    tools:src="@drawable/astronomia" />

                <!-- ExoPlayer View (Media3) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/exo_player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="true"
                    app:show_buffering="when_playing"
                    app:resize_mode="fit" />

                <ProgressBar
                    android:id="@+id/pb_video_loading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="@color/primary_blue" />
            </FrameLayout>

            <!-- Botón Cerrar Flotante -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_close_sheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_m"
                android:contentDescription="Cerrar"
                android:src="@drawable/ic_close"
                app:backgroundTint="@color/white"
                app:fabSize="mini"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/navy_blue" />

            <!-- Degradado semitransparente para textos sobre el hero -->
            <View
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_gradient_scrim"
                app:layout_constraintBottom_toBottomOf="@id/fl_media_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Modalidad y Categoría -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/fl_media_container"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tv_modal_modalidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rounded"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:backgroundTint="#FF9800"
                    tools:text="Híbrido" />

                <TextView
                    android:id="@+id/tv_modal_categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="#8D99AE"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Ciencia" />
            </LinearLayout>

            <!-- Play Video Button (Solo si no hay autostart o se quiere manual) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_play_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_m"
                android:layout_marginBottom="-28dp"
                android:contentDescription="Reproducir video"
                android:src="@drawable/ic_search"
                android:visibility="gone"
                app:backgroundTint="@color/primary_blue"
                app:fabSize="normal"
                app:layout_constraintBottom_toBottomOf="@id/fl_media_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@color/white" />

            <!-- Título Principal -->
            <TextView
                android:id="@+id/tv_modal_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/spacing_m"
                android:fontFamily="@font/fredoka"
                android:textColor="@color/navy_blue"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fl_media_container"
                tools:text="Astronomía" />

            <!-- Precio en Soles -->
            <TextView
                android:id="@+id/tv_modal_precio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_modal_titulo"
                tools:text="S/ 45.00" />

            <!-- Objetivo Pedagógico -->
            <TextView
                android:id="@+id/tv_modal_objetivo_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                android:fontFamily="@font/fredoka"
                android:text="Objetivo del Taller"
                android:textColor="@color/navy_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_modal_precio" />

            <TextView
                android:id="@+id/tv_modal_objetivo_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/spacing_m"
                android:fontFamily="@font/nunito"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_modal_objetivo_titulo"
                tools:text="Comprender el sistema solar y construir modelos a escala." />

            <View
                android:id="@+id/divider_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginVertical="@dimen/spacing_m"
                android:background="#E2E8F0"
                app:layout_constraintTop_toBottomOf="@id/tv_modal_objetivo_desc" />

            <!-- Layout horizontal para Temario y Materiales (Tabulación simple) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                app:layout_constraintTop_toBottomOf="@id/divider_1"
                app:layout_constraintBottom_toTopOf="@id/divider_2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="Temario"
                        android:textColor="@color/navy_blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/ll_temario_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="Materiales"
                        android:textColor="@color/navy_blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/ll_materiales_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/divider_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginTop="200dp"
                android:background="#E2E8F0"
                app:layout_constraintTop_toBottomOf="@id/divider_1" />

            <!-- Info Adicional (Horario y Vacantes) -->
            <LinearLayout
                android:id="@+id/ll_info_adicional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/divider_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Calendario"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/primary_blue" />

                    <TextView
                        android:id="@+id/tv_modal_horario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Sábados 4:00 PM - 6:00 PM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Vacantes"
                        android:src="@drawable/ic_users"
                        app:tint="@color/gold_yellow" />

                    <TextView
                        android:id="@+id/tv_modal_cupos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="10 vacantes" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botón CTA Destacado WhatsApp -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_whatsapp_inscribirse"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_l"
                android:backgroundTint="#25D366"
                android:fontFamily="@font/fredoka"
                android:text="Inscribirme por WhatsApp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_whatsapp"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/ll_info_adicional" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>