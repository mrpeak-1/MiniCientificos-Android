<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_workshop_pill_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <!-- Emoji / Icon Container -->
    <TextView
        android:id="@+id/tv_pildora_emoji"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_pill_500_kids"
        android:gravity="center"
        android:text="🔭"
        android:textSize="18sp" />

    <!-- Name -->
    <TextView
        android:id="@+id/tv_pildora_nombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/fredoka"
        android:maxLines="2"
        android:text="Astronomía"
        android:textColor="#0B2C5E"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Arrow Container -->
    <TextView
        android:id="@+id/tv_pildora_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_pill_500_kids"
        android:gravity="center"
        android:text="→"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>