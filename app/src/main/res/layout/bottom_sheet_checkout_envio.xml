<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:backgroundTint="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 1. CABECERA CÓSMICA AZUL MARINO (#0B2C5E con borde inferior amarillo #FDC500 de 4dp) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fl_checkout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_checkout_header_navy"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Título: Mini Científicos -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/fredoka"
                android:text="🛍️ Mini ✨ Científicos"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnCerrarCheckout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botón Circular ✕ Cerrar -->
            <ImageButton
                android:id="@+id/btnCerrarCheckout"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_action"
                android:backgroundTint="#123354"
                android:contentDescription="Cerrar"
                android:src="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <!-- Bloque de Frase Kalam en 2 Líneas -->
            <LinearLayout
                android:id="@+id/llPhraseBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/imgHeaderBanner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

                <TextView
                    android:id="@+id/tvHeaderPhrase1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kalam"
                    android:rotation="-2"
                    android:text="¡Aprender también es"
                    android:textColor="#FFFFFF"
                    android:textSize="18.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderPhrase2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:fontFamily="@font/kalam"
                    android:rotation="-2"
                    android:text="una aventura!"
                    android:textColor="#FFE56C"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Imagen Personajes Banner Formulario (Alineada Perfectamente con la Frase) -->
            <ImageView
                android:id="@+id/imgHeaderBanner"
                android:layout_width="160dp"
                android:layout_height="90dp"
                android:adjustViewBounds="true"
                android:contentDescription="Mascotas Titan y Tesla"
                android:scaleType="fitEnd"
                android:src="@drawable/banner_formulario"
                app:layout_constraintBottom_toBottomOf="@id/llPhraseBlock"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/llPhraseBlock" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- 2. TARJETA 1 - SECCIÓN "1. Datos de envío" -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Encabezado con Círculo Amarillo 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_badge_rounded"
                            android:backgroundTint="#FDC500"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#0B2C5E"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/fredoka"
                            android:text="Datos de envío"
                            android:textColor="#0B2C5E"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nunito"
                        android:text="Completa la información para que tu pedido llegue correctamente."
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <!-- Formulario de 7 Campos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Campo 1: Nombre completo * -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito"
                            android:text="👤 Nombre completo *"
                            android:textColor="#0B2C5E"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCheckoutNombre"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="#00A8E8">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCheckoutNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito"
                                android:hint="Ej. María López"
                                android:inputType="textPersonName"
                                android:textColor="#0B2C5E"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Fila Doble: Celular * y Correo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Col 1: Celular * -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="📞 Celular *"
                                    android:textColor="#0B2C5E"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilCheckoutCelular"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxStrokeColor="#00A8E8">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCheckoutCelular"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/nunito"
                                        android:hint="Ej. 987654321"
                                        android:inputType="phone"
                                        android:maxLength="9"
                                        android:textColor="#0B2C5E"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <!-- Col 2: Correo (opcional) -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="✉️ Correo (opcional)"
                                    android:textColor="#0B2C5E"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilCheckoutCorreo"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxStrokeColor="#00A8E8">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCheckoutCorreo"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/nunito"
                                        android:hint="Ej. correo@ejemplo.com"
                                        android:inputType="textEmailAddress"
                                        android:textColor="#0B2C5E"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Campo 3: Dirección * -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/nunito"
                            android:text="📍 Dirección de envío *"
                            android:textColor="#0B2C5E"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCheckoutDireccion"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="#00A8E8">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCheckoutDireccion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito"
                                android:hint="Ej. Av. Los Olivos 123, Urb. El Solar"
                                android:inputType="textPostalAddress"
                                android:textColor="#0B2C5E"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Fila Doble: Distrito * y Provincia * -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Col 1: Distrito * -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="Distrito *"
                                    android:textColor="#0B2C5E"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilCheckoutDistrito"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxStrokeColor="#00A8E8">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCheckoutDistrito"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/nunito"
                                        android:hint="Ej. Los Olivos"
                                        android:inputType="text"
                                        android:textColor="#0B2C5E"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                            <!-- Col 2: Provincia * -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito"
                                    android:text="Provincia *"
                                    android:textColor="#0B2C5E"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilCheckoutProvincia"
                                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxStrokeColor="#00A8E8">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCheckoutProvincia"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/nunito"
                                        android:hint="Ej. Lima"
                                        android:inputType="text"
                                        android:textColor="#0B2C5E"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Campo 5: Departamento * (AutoCompleteTextView) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/nunito"
                            android:text="Departamento *"
                            android:textColor="#0B2C5E"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCheckoutDepartamento"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="#00A8E8">

                            <AutoCompleteTextView
                                android:id="@+id/actvCheckoutDepartamento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito"
                                android:hint="Ej. Lima"
                                android:inputType="none"
                                android:textColor="#0B2C5E"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- CheckBox Recordar Datos -->
                    <CheckBox
                        android:id="@+id/cbRecordarDatos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/nunito"
                        android:text="💾 Recordar mis datos de envío para mi próxima compra"
                        android:textColor="#0B2C5E"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <!-- 2 Cajas Informativas Celestes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_info_box_celeste"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚚 "
                            android:textSize="20sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/fredoka"
                                android:text="El costo de envío se coordina al confirmar el pedido."
                                android:textColor="#0B2C5E"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/nunito"
                                android:text="Te contactaremos para validar la dirección y el costo."
                                android:textColor="#4A6572"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_info_box_celeste"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ℹ️ "
                            android:textSize="19sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito"
                            android:lineSpacingExtra="3dp"
                            android:text="El pedido no se confirma hasta que el equipo verifique el pago. La pasarela de pago aún no está integrada."
                            android:textColor="#0B2C5E"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. TARJETA 2 - SECCIÓN "Resumen de tu pedido" Y MOTOR DE CUPONES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F4F9FF"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fredoka"
                        android:text="Resumen de tu pedido"
                        android:textColor="#0B2C5E"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <!-- RecyclerView de Ítems del Pedido -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCheckoutResumenItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />

                    <!-- Caja de Cupón de Descuento (bg_coupon_box_yellow.xml) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_coupon_box_yellow"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka"
                            android:text="🏷️ ¿Tienes un cupón de descuento?"
                            android:textColor="#0B2C5E"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etCodigoCupon"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_info_box_celeste"
                                android:backgroundTint="#FFFFFF"
                                android:fontFamily="@font/fredoka"
                                android:hint="Ej: MINI10, CIENCIA20"
                                android:inputType="textCapCharacters"
                                android:paddingHorizontal="12dp"
                                android:textColor="#0B2C5E"
                                android:textSize="13.5sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAplicarCupon"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="#0B2C5E"
                                android:fontFamily="@font/fredoka"
                                android:text="Aplicar"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnQuitarCupon"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="6dp"
                                android:backgroundTint="#EF4444"
                                android:fontFamily="@font/fredoka"
                                android:text="Quitar"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:visibility="gone"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFeedbackCupon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/nunito"
                            android:text="Prueba: MINI10, CIENCIA20 o EXPLORADOR15"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Desglose Numérico -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCheckoutSubtotalLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/nunito"
                                android:text="Subtotal"
                                android:textColor="#64748B"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvCheckoutSubtotalValor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/fredoka"
                                android:textColor="#0B2C5E"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="S/ 134.80" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llCheckoutFilaDescuento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/nunito"
                                android:text="Descuento cupón"
                                android:textColor="#15803D"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCheckoutDescuentoValor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/fredoka"
                                android:textColor="#15803D"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="- S/ 13.48" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Caja Total Estimado -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_total_estimado_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/fredoka"
                            android:text="TOTAL ESTIMADO"
                            android:textColor="#0B2C5E"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCheckoutTotalEstimado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka"
                            android:shadowColor="#FDC500"
                            android:shadowDx="3"
                            android:shadowDy="3"
                            android:shadowRadius="1"
                            android:textColor="#0B2C5E"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="S/ 134.80" />
                    </LinearLayout>

                    <!-- Bloque Ilustrado de Reparto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/kalam"
                            android:text="¡Tu pedido está en camino!"
                            android:textColor="#0B2C5E"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/imgMascotaCamion"
                            android:layout_width="140dp"
                            android:layout_height="80dp"
                            android:layout_marginTop="6dp"
                            android:contentDescription="Camión de reparto Titan"
                            android:scaleType="fitCenter"
                            android:src="@drawable/mascota_camion" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. BOTONES FINALES DE ACCIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Botón Principal Verde WhatsApp 3D -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnConfirmarPedidoFinal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_btn_whatsapp_3d"
                    android:fontFamily="@font/fredoka"
                    android:stateListAnimator="@null"
                    android:text="💬 Continuar con el pedido →"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Botón Secundario Volver al Carrito -->
                <TextView
                    android:id="@+id/btnVolverAlCarrito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fredoka"
                    android:padding="8dp"
                    android:text="← Volver al carrito"
                    android:textColor="#0B2C5E"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>